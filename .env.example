# คัดลอกไฟล์นี้เป็น .env.local สำหรับรันบนเครื่อง (ห้าม commit ค่าจริงขึ้น GitHub)

# จาก LINE Developers Console > Messaging API tab
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# จาก aistudio.google.com/apikey
GEMINI_API_KEY=
# ไม่บังคับ - ไม่ใส่จะใช้ gemini-2.5-flash เป็นค่าเริ่มต้น
GEMINI_MODEL=gemini-2.5-flash

# ไม่บังคับ - ถ้าใส่ค่านี้ บอทจะดึงข้อมูล FAQ จาก Google Sheet แทนไฟล์ data/faq.js
# วิธีได้ลิงก์นี้ดูในหัวข้อ "เชื่อม Google Sheet" ใน README.md
GOOGLE_SHEET_CSV_URL=
